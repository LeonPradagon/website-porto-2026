VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SITE_URL=https://your-domain.com
# Server/Drizzle migrations only. Use Supabase's Session Pooler (port 5432).
# Never expose either database URL through a VITE_ variable.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Netlify Functions runtime. Use Supabase's Transaction Pooler (port 6543).
SUPABASE_DB_RUNTIME_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
